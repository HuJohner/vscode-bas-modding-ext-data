            "type": "string"
        },
        "itemVariableName": {
            "type": "string"
        },
        "creatureIds": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "creatureFilter": {
            "type": "string",
            "default": "NoneExcept",
            "enum": [
                "NoneExcept",
                "AnyExcept"
            ]
        },
        "creatureVariableQuestId": {
            "type": "string"
        },
        "creatureVariableName": {
            "type": "string"
        }
